# Synology Photos API (the existing FastAPI backend)
SYNOLOGY_API_BASE=http://localhost:8000

# Ollama (local LLMs — only needed for --planner algo/api, not visual)
OLLAMA_BASE=http://localhost:11434
VISION_MODEL=llava:13b
PLANNING_MODEL=llama3:8b

# Whisper model size (tiny, base, small, medium)
WHISPER_MODEL=medium

# Default workspace directory
WORKSPACE=./workspace

# Gemini API key (for --planner visual and --planner api, recommended)
GEMINI_API_KEY=

# Anthropic API key (legacy, only if using Claude directly)
# ANTHROPIC_API_KEY=sk-ant-...

# Music generation uses MusicGen (facebook/musicgen-medium) locally — no API key needed
