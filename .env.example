# Synology Photos API (the existing FastAPI backend)
SYNOLOGY_API_BASE=http://localhost:8000

# Ollama (local LLMs)
OLLAMA_BASE=http://localhost:11434
VISION_MODEL=llava:7b
PLANNING_MODEL=qwen2.5-coder:7b

# Whisper model size (tiny, base, small, medium)
WHISPER_MODEL=small

# Default workspace directory
WORKSPACE=./workspace

# Music generation uses MusicGen (facebook/musicgen-small) locally — no API key needed
